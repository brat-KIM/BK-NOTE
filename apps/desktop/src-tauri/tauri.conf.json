{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BK-NOTE",
  "version": "0.1.0",
  "identifier": "com.bknote.sticky",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @bk-note/web dev",
    "beforeBuildCommand": "pnpm --filter @bk-note/web build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BK-NOTE",
        "width": 380,
        "height": 900,
        "minWidth": 280,
        "minHeight": 320,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Korean", "English"] },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
